{
  "description": "接續研究進度，依明確交付紀錄維護成果入口",
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "uv run --no-project --no-python-downloads python \"${CLAUDE_PLUGIN_ROOT}/scripts/research_hooks.py\" hook",
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "matcher": "Write|Edit|MultiEdit|Bash",
      "hooks": [{
        "type": "command",
        "command": "uv run --no-project --no-python-downloads python \"${CLAUDE_PLUGIN_ROOT}/scripts/research_hooks.py\" hook",
        "timeout": 10
      }]
    }]
  }
}
